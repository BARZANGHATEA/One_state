# Copy this file to ".env" (only needed on your PC for login.bat).
# The same values go into Vercel (Environment Variables) and GitHub (Secrets).

# From @BotFather
BOT_TOKEN=
# Your numeric Telegram ID (send /myid to the bot, or ask @userinfobot)
ADMIN_ID=
# Any long random password. MUST be identical on PC, Vercel and GitHub.
SESSION_KEY=

# ---- Vercel only ----
# Letters, numbers, _ and - only
WEBHOOK_SECRET=
CRON_SECRET=
# GitHub fine-grained token with "Actions: Read and write" on this repo
GH_TOKEN=
# yourname/onestate-bot
GH_REPO=

# ---- Optional ----
# Store the data file in a private channel instead of your chat with the bot (bot must be admin there)
# STORE_CHAT_ID=-100xxxxxxxxxx
# Current event (in the site address /events/halloween/...)
# EVENT_SLUG=halloween
# Name of the store item to buy every day
# ITEM_NAME=1
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
